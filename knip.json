{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,template,default,loading,error,global-error,not-found,route,sitemap,robots,manifest}.{ts,tsx}",
    "src/app/**/{opengraph-image,twitter-image,icon,apple-icon}.{ts,tsx}",
    "scripts/**/*.{ts,js}",
    "__tests__/**/*.test.{ts,tsx}",
    "__tests__/helpers/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["src/lib/types/database.ts"],
  "ignoreDependencies": ["@typescript-eslint/eslint-plugin", "eslint-import-resolver-typescript"]
}
