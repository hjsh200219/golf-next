{
  "name": "golf-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dead-code": "knip",
    "gc": "npm run lint && npx tsc --noEmit && npm run test && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-table": "^8.20.0",
    "cheerio": "^1.0.0",
    "fetch-cookie": "^3.0.0",
    "next": "^14.2.35",
    "next-pwa": "^5.6.0",
    "ngeohash": "^0.6.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.0",
    "sonner": "^2.0.7",
    "swr": "^2.2.0",
    "tough-cookie": "^4.1.0",
    "undici": "^7.24.6",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/tough-cookie": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "iconv-lite": "^0.6.3",
    "jsdom": "^24.0.0",
    "knip": "^6.16.0",
    "lint-staged": "^16.4.0",
    "msw": "^2.3.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bash -c 'npx tsc --noEmit'"
    ],
    "*.{js,jsx,ts,tsx}": [
      "next lint --fix --file"
    ]
  }
}
