#!/usr/bin/env sh
# golf-next 자동 push — [R-push] 예외 열여섯(2026-10-17 사용자 「이 repo도 자동 push」).
# main 커밋만 · fast-forward push 만(force·태그·다른 브랜치 없음) · 추가된 줄에 시크릿 패턴이 있으면 올리지 않는다.
# Vercel 연동이라 이 push 는 운영 배포다. 끄기: GOLF_NEXT_AUTOPUSH=0
[ "${GOLF_NEXT_AUTOPUSH:-1}" = 0 ] && exit 0
[ "$(git rev-parse --abbrev-ref HEAD)" = main ] || exit 0
# launchd 잡 안에서 커밋하면 잡이 끝날 때 백그라운드 push 가 함께 죽는다 — setsid 로 새 세션에 떼어 낸다.
if [ -z "${AUTOPUSH_DETACHED:-}" ] && command -v perl >/dev/null 2>&1; then
  AUTOPUSH_DETACHED=1 exec perl -MPOSIX=setsid -e 'setsid(); fork and exit; exec @ARGV' /bin/sh "$0" "$@" </dev/null >/dev/null 2>&1
fi
LOG="$HOME/Library/Logs/golf-next-autopush.log"
SECRET='(xox[baprs]-[A-Za-z0-9-]{10,}|gh[pousr]_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|glpat-[A-Za-z0-9_-]{15,}|-----BEGIN [A-Z ]*PRIVATE KEY|postgres(ql)?://[^[:space:]]*:[^[:space:]@]*@)'
(
  unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE
  sleep 5 # 연속 커밋 묶기
  echo "--- $(date '+%F %T') $(git log -1 --format=%h)"
  git fetch -q origin main || { echo "fetch 실패 — 보류"; exit 0; }
  git merge-base --is-ancestor origin/main main || { echo "origin/main 과 갈라짐 — 보류(사람이 정리)"; exit 0; }
  if git diff origin/main..main | grep '^+' | grep -Eq "$SECRET"; then echo "시크릿 패턴 — 보류"; exit 0; fi
  git push -q origin main || { echo "push 실패"; exit 0; }
  echo "push 완료"
) >>"$LOG" 2>&1 </dev/null &
exit 0
